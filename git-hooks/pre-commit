#!/usr/bin/env sh
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit: (1) refuse direct commits to a protected branch, and
#             (2) block commits that introduce secrets (gitleaks).
#
# The Brain workflow is PR-based — work happens on a feature branch and lands on
# master/main through a pull request, never a direct commit. This hook is the
# belt-and-suspenders guard for both humans and agents. This repo is also
# PUBLIC-mirrored (github.com/LDJ-Share/.dotfiles), so it additionally runs a
# secret scan — see PUBLIC.md.
#
# Scope: code repos only (enabled per-repo via core.hooksPath — see README.md).
# Override (rare, intentional): git commit --no-verify
# ─────────────────────────────────────────────────────────────────────────────

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"

case "$branch" in
  master|main)
    echo "pre-commit: refusing to commit directly to '$branch'." >&2
    echo "  Start a branch:  git switch -c feat/<name>" >&2
    echo "  Override (rare): git commit --no-verify" >&2
    exit 1
    ;;
esac

# Secret scan — this repo is PUBLIC-mirrored; never commit secrets (see PUBLIC.md).
# Fail closed on findings; if gitleaks is missing, warn loudly but allow (don't
# block every commit on a missing tool — install it: https://github.com/gitleaks/gitleaks).
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner; then
    echo "pre-commit: gitleaks found potential secrets in staged changes (above)." >&2
    echo "  This repo is PUBLIC-mirrored — do not commit secrets. See PUBLIC.md." >&2
    echo "  Override (rare): git commit --no-verify" >&2
    exit 1
  fi
else
  echo "pre-commit: WARNING — gitleaks not installed; secret scan SKIPPED." >&2
  echo "  This repo is PUBLIC-mirrored. Install: https://github.com/gitleaks/gitleaks" >&2
fi

exit 0
